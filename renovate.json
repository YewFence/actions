{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["dockerfile", "github-actions", "mise", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^binaries\\.toml$/"],
      "matchStrings": [
        "source = \"https://github\\.com/(?<depName>[^\"\\s]+)\\.git\"\\s+tag = \"(?<currentValue>[^\"]+)\"\\s+revision = \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-tags",
      "packageNameTemplate": "https://github.com/{{{depName}}}.git",
      "versioningTemplate": "regex:^r(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Point deb lookups for pgbackrest at the pgdg bookworm repository",
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["deb"],
      "matchFileNames": ["images/postgres-pgbackrest/**"],
      "registryUrls": ["http://apt.postgresql.org/pub/repos/apt?suite=bookworm-pgdg&components=main&binaryArch=amd64"]
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["binaries.toml"],
      "groupName": "prebuilt {{depName}}"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["binaries/**"],
      "groupName": "binary {{parentDir}} build image"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "groupName": "repo mise tools"
    },
    {
      "matchFileNames": ["images/**"],
      "groupName": "image {{parentDir}}"
    }
  ]
}
